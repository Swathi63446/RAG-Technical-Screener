# ==================================================
# AI-Powered Candidate Screening System - Environment Variables
# ==================================================
# Copy this file to .env and fill in your values

# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=gemini

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Google Gemini Configuration (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite by default)
DATABASE_URL=sqlite:///interview.db

# ChromaDB path for vector storage
CHROMA_DB_PATH=./chroma_db

# Knowledge base directory (put role-specific PDFs here)
KNOWLEDGE_BASE_PATH=./knowledge_base

# File upload directory
UPLOAD_FOLDER=./uploads

# Interview settings
MAX_QUESTIONS=8
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
f